# Morrow environment — copy to .env and fill in. Never commit .env.

# ── LLM ────────────────────────────────────────────────────────────────
# OpenAI-compatible API. The default points to DeepSeek; replace it as needed.
LLM_BASE_URL=https://api.deepseek.com/v1
# Optional: omitted or blank uses deepseek-flash. Other providers may require a different model ID.
LLM_MODEL=deepseek-flash
# API key（DeepSeek 控制台获取）。切中转站时也可改用 LLM_API_KEY。
DEEPSEEK_API_KEY=
# LLM_API_KEY=        # 可选：优先于 DEEPSEEK_API_KEY，给中转站用
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_THINK_BUDGET=2048

# ── 天气（和风，专属 host）────────────────────────────────────────────────
# 主页天气区 + Morrow get_weather 工具共用。host/key 在和风控制台获取。
QWEATHER_HOST=
QWEATHER_KEY=

# ── 访问密码 ────────────────────────────────────────────────────────────
# Required. Use a long, unique password.
AUTH_PASSWORD=

# ── Flask ──────────────────────────────────────────────────────────────
PORT=5151
FLASK_DEBUG=0
# Legacy filename retained for existing installations; it does not affect the app name.
# Changing this path does not migrate an existing database.
# DB_PATH=data/nook.db
# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Web Push contact identity. Use a real administrative email when enabling push.
VAPID_SUBJECT=mailto:admin@example.com

# ── Optional integrations ──────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NODE_BIN=node
METING_KUGOU_COOKIE=
METING_NETEASE_COOKIE=

# ── GitHub 云端备份（独立私有仓库）──────────────────────────────────────
# 格式：owner/repository。不要填写当前代码仓库。
GITHUB_BACKUP_REPO=
# 仅授权上面私有仓库 Contents: Read and write 的细粒度 Token。
GITHUB_BACKUP_TOKEN=
# 至少 16 个字符；只保存在服务器与离线密码库，遗失后无法解密云端备份。
CLOUD_BACKUP_PASSPHRASE=
# 只在承担正式自动备份的服务器设为 1；本地开发机保持 0。
GITHUB_BACKUP_AUTO_ALLOWED=0
